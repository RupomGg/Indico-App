# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://indico_user:indico_password@localhost:5432/indico_db?schema=public"

# HTTP Server Configuration
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"

# JWT / Session Secrets
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# Blockchain RPC Configuration
RPC_URL="https://sepolia.base.org"
CHAIN_ID=84532
INDICO_LEDGER_ADDRESS="0x422D36E2198863C5b2A6B8E2865fBf5196de96cF"
USDC_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"

# Object Storage / Encryption (Local / S3 Compatible)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
DOCUMENT_ENCRYPTION_KEY="replace-with-a-secure-32-byte-hex-key"
